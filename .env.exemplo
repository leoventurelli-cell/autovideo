# Copie este arquivo para ".env" e preencha. NUNCA publique o .env.

# Roteiro (grátis): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clipes de vídeo (grátis): https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube (rode: python autorizar_youtube.py)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACIDADE=public

# TikTok (rode: python autorizar_tiktok.py)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=
# rascunho = vai pro app e você toca em Publicar | direto = publica sozinho (privado até a auditoria)
TIKTOK_MODO=rascunho

# Opcionais
NICHO=curiosidades incríveis e pouco conhecidas sobre o mundo
VOZ=pt-BR-AntonioNeural
DURACAO_ALVO=45
PUBLICAR_YOUTUBE=sim
PUBLICAR_TIKTOK=sim
